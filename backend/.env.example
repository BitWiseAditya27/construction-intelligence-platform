# AI Configuration (Optional: runs in rich deterministic baseline demo mode if omitted)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Weather API (Optional: Open-Meteo free live API works out-of-the-box without key)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Database
DATABASE_URL=sqlite:///./construction_intelligence.db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# CORS
FRONTEND_ORIGIN=http://localhost:5173
